#!/usr/bin/env bash
# herdr-fork [-a "extra claude args"] [-C subdir] <name> <task...>
#   Fork the calling Claude session into a new tab of its Herdr workspace. The fork
#   starts with a copy of the whole conversation so far (claude --resume <id>
#   --fork-session), then gets <task>. It opens in the caller's folder or (with -C)
#   a folder inside it, and writes its report to /tmp/herd/<name>.md.
# herdr-fork list
#   List the other agents in the caller's workspace (forks among them).
# herdr-fork close <name>
#   Close a fork's tab in the caller's workspace.
#
# In the Herdr desktop app (HC_TERMINAL_ID is set), a workspace is a space, the
# fork's name is its tab's name, and the app sends the task once the fork is ready.
#
# Exit status: 0 ok, 1 Herdr error, 2 refused (bad arguments, not in Herdr or a
# Claude session, name in use, folder outside the caller's), 3 the fork started but
# is blocked at startup (e.g. a folder-trust prompt) and has not received its task.
set -euo pipefail
herdr=${HERDR_BIN_PATH:-herdr}
app=${HERDR_APP_BIN:-herdr-app}
hc=${HC_BIN:-hc}

if [ -n "${HERDR_WORKSPACE_ID:-}" ]; then
  mode=herdr
elif [ -n "${HC_TERMINAL_ID:-}" ]; then
  mode=app
else
  echo "herdr-fork: this session does not run inside Herdr (neither HERDR_WORKSPACE_ID nor HC_TERMINAL_ID is set)" >&2
  exit 2
fi

agents_json() { "$herdr" agent list | jq -c '.result.agents'; }
# The desktop app's tabs, one per line: {space, tab, name, mine, terminals}.
tabs_json() {
  "$app" ls | jq -c --arg me "$HC_TERMINAL_ID" '.spaces[] | .id as $space | .tabs[]
    | {space: $space, tab: .id, name: (if .named == false then null else .name end), mine: any(.terminals[]; .terminal == $me), terminals}'
}
if [ "$mode" = app ]; then
  my_space=$("$app" ls | jq -r --arg me "$HC_TERMINAL_ID" \
    'first(.spaces[] | select(any(.tabs[].terminals[]; .terminal == $me)) | .id) // empty')
  if [ -z "$my_space" ]; then
    echo "herdr-fork: terminal $HC_TERMINAL_ID is not in a Herdr app space" >&2
    exit 1
  fi
fi

case "${1:-}:$mode" in
  list:app)
    cwds=$("$hc" ls --json | jq -c '[.terminals[]? | {key: .address, value: .cwd}] | from_entries')
    tabs_json | jq -r --arg ws "$my_space" --argjson cwd "$cwds" '
      select(.space == $ws and (.mine | not) and .name != null)
      | "\(.name)\t\(.tab)\t\(.terminals[0].status // "-")\t\($cwd[.terminals[0].terminal] // "-")"'
    exit 0 ;;
  close:app)
    [ $# -eq 2 ] || { echo "usage: herdr-fork close <name>" >&2; exit 2; }
    found=$(tabs_json | jq -c --arg n "$2" 'select(.name == $n)' | head -1)
    if [ -z "$found" ]; then
      echo "herdr-fork: no tab named $2" >&2; exit 2
    fi
    if [ "$(jq -r .space <<<"$found")" != "$my_space" ]; then
      echo "herdr-fork: $2 is in another space; only tabs in this one can be closed here" >&2; exit 2
    fi
    if [ "$(jq -r .mine <<<"$found")" = true ]; then
      echo "herdr-fork: $2 is your own tab; refusing to close it" >&2; exit 2
    fi
    tab=$(jq -r .tab <<<"$found")
    "$app" do tab.close --id "$tab" --confirmed true >/dev/null
    echo "closed $2 ($tab)"
    exit 0 ;;
  list:*)
    agents_json | jq -r --arg ws "$HERDR_WORKSPACE_ID" --arg me "${HERDR_PANE_ID:-}" '
      .[] | select(.workspace_id == $ws and .pane_id != $me)
      | "\(.name)\t\(.tab_id)\t\(.agent_status // "-")\t\(.cwd // "-")"'
    exit 0 ;;
  close:*)
    [ $# -eq 2 ] || { echo "usage: herdr-fork close <name>" >&2; exit 2; }
    found=$(agents_json | jq -c --arg n "$2" '.[] | select(.name == $n)')
    if [ -z "$found" ]; then
      echo "herdr-fork: no agent named $2" >&2; exit 2
    fi
    if [ "$(jq -r .workspace_id <<<"$found")" != "$HERDR_WORKSPACE_ID" ]; then
      echo "herdr-fork: $2 is in another workspace; only tabs in this one can be closed here" >&2; exit 2
    fi
    if [ "$(jq -r .pane_id <<<"$found")" = "${HERDR_PANE_ID:-}" ]; then
      echo "herdr-fork: $2 is running in your own tab; refusing to close it" >&2; exit 2
    fi
    tab=$(jq -r .tab_id <<<"$found")
    "$herdr" tab close "$tab" >/dev/null
    echo "closed $2 ($tab)"
    exit 0 ;;
esac

extra="--permission-mode auto"
dir=$PWD
while getopts "a:C:" opt; do
  case $opt in
    a) extra=$OPTARG ;;
    C) dir=$OPTARG ;;
    *) exit 2 ;;
  esac
done
shift $((OPTIND - 1))
if [ $# -lt 2 ]; then
  echo "usage: herdr-fork [-a \"claude args\"] [-C subdir] <name> <task...> | list | close <name>" >&2
  exit 2
fi
name=$1; shift
task="$*"

session=${CLAUDE_CODE_SESSION_ID:-}
if [ -z "$session" ]; then
  echo "herdr-fork: CLAUDE_CODE_SESSION_ID is not set; run herdr-fork from a Claude Code session's shell" >&2
  exit 2
fi

# Claude Code keeps each session at ~/.claude/projects/<folder>/<id>.jsonl.
# --resume finds it from any folder, so a fork in -C <subdir> works as well.
projects=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects
if [ -z "$(find "$projects" -maxdepth 2 -name "$session.jsonl" -print -quit 2>/dev/null)" ]; then
  echo "herdr-fork: no transcript for session $session under $projects" >&2
  exit 2
fi
dir=$(cd "$dir" 2>/dev/null && pwd -P) || { echo "herdr-fork: -C folder not found" >&2; exit 2; }
here=$(pwd -P)
case "$dir/" in
  "$here/"*) ;;
  *) echo "herdr-fork: -C $dir is outside the caller's folder ($here)" >&2; exit 2 ;;
esac
if [ "$mode" = app ]; then
  in_use=$(tabs_json | jq -r --arg n "$name" 'select(.name == $n) | .name')
else
  in_use=$(agents_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .name')
fi
if [ -n "$in_use" ]; then
  echo "herdr-fork: the name $name is already in use by a Herdr agent (names are unique across all workspaces); pick another" >&2
  exit 2
fi

mkdir -p /tmp/herd
report=/tmp/herd/$name.md
task="You are a fork of the conversation above, running in your own Herdr tab named $name. The session you were forked from keeps working on its own; do not repeat its work. Your task:

$task

When you are completely done, write a full report (what you did, files touched, how you verified it) to $report. Keep your terminal reply to a short summary."

if [ "$mode" = app ]; then
  # $extra is deliberately word-split into claude args
  argv=$(printf "%s\0" claude $extra --resume "$session" --fork-session | jq -Rsc 'split("\u0000")[:-1]')
  created=$("$app" do tab.new --name "$name" --space "$my_space" --folder "$dir" --argv "$argv" --task "$task") || exit 1
  tab=$(jq -r .tab <<<"$created")
  terminal=$(jq -r .terminal <<<"$created")
  echo "fork=$name session=$session tab=$tab terminal=$terminal cwd=$dir report=$report"
  exit 0
fi

created=$("$herdr" tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$dir" --label "$name" --no-focus) || exit 1
pane=$(jq -r '.result.root_pane.pane_id' <<<"$created")
tab=$(jq -r '.result.tab.tab_id' <<<"$created")
# $extra is deliberately word-split into claude args
if ! start_err=$("$herdr" agent start "$name" --kind claude --pane "$pane" -- $extra --resume "$session" --fork-session 2>&1 >/dev/null); then
  if [ "$(jq -r '.error.code // empty' <<<"$start_err" 2>/dev/null)" = agent_not_ready ]; then
    printf '%s\n' "$task" > "/tmp/herd/$name.task"
    if "$herdr" pane read "$pane" --source visible 2>/dev/null | grep -qi "trust"; then
      echo "herdr-fork: $name is waiting at a folder-trust prompt in tab $tab ($dir). Ask the user to approve it there, then send the task with: herdr agent prompt $name \"\$(cat /tmp/herd/$name.task)\"" >&2
    else
      echo "herdr-fork: $name is blocked during startup in tab $tab; read it with: herdr agent read $name --source visible. Once it is ready, send the task with: herdr agent prompt $name \"\$(cat /tmp/herd/$name.task)\"" >&2
    fi
    exit 3
  fi
  "$herdr" tab close "$tab" >/dev/null 2>&1 || true
  echo "herdr-fork: $name did not start, so its tab $tab was closed: $start_err" >&2
  exit 1
fi
"$herdr" agent prompt "$name" "$task" >/dev/null
echo "fork=$name session=$session tab=$tab pane=$pane cwd=$dir report=$report"
