#!/usr/bin/env bash
# fork-attach <id>
#   Run by fork-open in the fork's pane: attach to the background fork session, and
#   when Herdr closes the pane (SIGHUP) or kills it (SIGTERM), stop or remove the
#   session. Leaving the attach view normally leaves the session alone.
#   What happens on close: HERDR_FORK_ON_CLOSE (fork-open sets it from the env or
#   the plugin's onClose option), else stop. stop keeps the conversation (claude attach <id> resumes it), remove
#   runs claude rm (it refuses to discard unpushed worktree commits), keep does nothing.
#   In the Herdr desktop app it also reports the fork's status (see report).
id=$1
claude=${HERDR_FORK_CLAUDE:-claude}
on_close=${HERDR_FORK_ON_CLOSE:-stop}

# Herdr kills what is left in a closed pane about a second after the hang-up, so the
# cleanup runs detached in its own session (perl setsid) and this script exits at once.
closed() {
  trap '' HUP TERM INT
  [ -n "$reporter" ] && kill "$reporter" 2>/dev/null
  local c i
  c=$(printf %q "$claude"); i=$(printf %q "$id")
  case $on_close in
    stop) set -- "$c stop $i" ;;
    remove) set -- "$c stop $i; $c rm $i" ;;
    *) exit 0 ;;
  esac
  perl -e 'use POSIX qw(setsid); fork and exit; setsid; exec @ARGV' bash -c "$1" \
    </dev/null >/dev/null 2>&1
  exit 0
}

# The desktop app shows a pane as an agent from the status its program reports with
# OSC 7501. claude attach does not pass the background session's status on, so
# report it from the session's file (sessions/<pid>.json) while this script runs:
# busy or shell is working, waiting is blocked, and idle after work is done.
report() {
  local sessions=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions last="" said="" word wait state msg
  while kill -0 $$ 2>/dev/null; do
    IFS=$'\t' read -r word wait < <(jq -r --arg j "$id" \
      'select(.jobId == $j) | [.status, .waitingFor // ""] | @tsv' "$sessions"/*.json 2>/dev/null | head -1)
    case $word in
      busy|shell) state=working ;;
      waiting) state=blocked ;;
      idle) case $last in ""|idle) state=idle ;; *) state=done ;; esac ;;
      *) state=$last ;;
    esac
    msg=""
    [ "$state" = blocked ] && [ -n "$wait" ] && msg=":msg=$(printf '%s' "$wait" | base64 | tr -d '\n')"
    if [ -n "$state" ] && [ "$state$msg" != "$said" ]; then
      printf '\033]7501;state=%s:app=claude-code%s\033\\' "$state" "$msg"
      said=$state$msg
    fi
    last=$state
    sleep 1
  done
}

reporter=""
trap closed HUP TERM
if [ -n "${HC_TERMINAL_ID:-}" ]; then report & reporter=$!; fi

"$claude" attach "$id"; rc=$?
[ -n "$reporter" ] && kill "$reporter" 2>/dev/null
exit "$rc"
