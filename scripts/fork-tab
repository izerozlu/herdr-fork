#!/usr/bin/env bash
# SessionStart hook. Claude Code's /fork starts the fork as a background session; its
# job folder ($CLAUDE_JOB_DIR) holds parent-transcript.jsonl, which a plain --bg
# session does not have. Inside Herdr, open the fork next to the pane it was forked
# from, running `claude attach <id>`, so it can be watched and prompted there.
# HERDR_FORKS_LAYOUT picks where: right (default) or down splits that pane, tab opens
# a new tab in its workspace. Never fails the session: Herdr errors only print a note.
set -uo pipefail
input=$(cat)
[ -n "${HERDR_WORKSPACE_ID:-}" ] || exit 0
[ -n "${CLAUDE_JOB_DIR:-}" ] && [ -f "$CLAUDE_JOB_DIR/parent-transcript.jsonl" ] || exit 0
session=$(jq -r '.session_id // empty' <<<"$input")
cwd=$(jq -r '.cwd // empty' <<<"$input")
[ -n "$session" ] || exit 0
short=${session:0:8}
herdr=${HERDR_BIN_PATH:-herdr}

layout=${HERDR_FORKS_LAYOUT:-right}
case $layout in
  right|down|tab) ;;
  *) echo "herdr-forks: HERDR_FORKS_LAYOUT=$layout is not right, down or tab; using right" >&2; layout=right ;;
esac
[ -n "${HERDR_PANE_ID:-}" ] || layout=tab

if [ "$layout" = tab ]; then
  created=$("$herdr" tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "${cwd:-$PWD}" --label "fork $short" --focus 2>&1); rc=$?
  query=.result.root_pane.pane_id
else
  created=$("$herdr" pane split "$HERDR_PANE_ID" --direction "$layout" --cwd "${cwd:-$PWD}" --focus 2>&1); rc=$?
  query=.result.pane.pane_id
fi
if [ "$rc" -ne 0 ]; then
  echo "herdr-forks: could not open a $layout pane for fork $short: $created" >&2
  exit 0
fi
pane=$(jq -r "$query // empty" <<<"$created" 2>/dev/null)
if [ -z "$pane" ] || ! "$herdr" pane run "$pane" "claude attach $short" >/dev/null 2>&1; then
  echo "herdr-forks: opened a pane for fork $short but could not attach; run: claude attach $short" >&2
fi
exit 0
